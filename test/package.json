{
  "name": "bedrock-meter-usage-reporter-test",
  "version": "0.0.1-0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --preserve-symlinks test.js test",
    "test:debug": "node --preserve-symlinks test.js test --log-level debug",
    "coverage": "cross-env NODE_ENV=test c8 npm test",
    "coverage-ci": "cross-env NODE_ENV=test c8 --reporter=lcovonly --reporter=text-summary --reporter=text npm test",
    "coverage-report": "c8 report"
  },
  "dependencies": {
    "@bedrock/app-identity": "^4.2.0",
    "@bedrock/core": "^6.3.0",
    "@bedrock/did-io": "^10.5.0",
    "@bedrock/express": "^8.8.1",
    "@bedrock/https-agent": "^4.1.0",
    "@bedrock/jsonld-document-loader": "^5.2.1",
    "@bedrock/meter": "^6.0.0",
    "@bedrock/meter-http": "^14.0.0",
    "@bedrock/meter-usage-reporter": "file:..",
    "@bedrock/mongodb": "^11.0.1",
    "@bedrock/server": "^5.2.1",
    "@bedrock/test": "^10.0.0",
    "@bedrock/zcap-storage": "^9.7.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ezcap": "^4.4.0",
    "abort-controller": "^3.0.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "sinon": "^22.1.0"
  },
  "c8": {
    "excludeNodeModules": false,
    "include": [
      "node_modules/@bedrock/meter-usage-reporter/**"
    ],
    "exclude": [
      "node_modules/@bedrock/meter-usage-reporter/node_modules/**"
    ],
    "reporter": [
      "lcov",
      "text-summary",
      "text"
    ]
  }
}
